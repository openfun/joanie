<mjml>
  <mj-include path="./partial/header.mjml" />
  <mj-body mj-class="bg--blue-100">
    <mj-wrapper css-class="wrapper" padding="20px 40px 40px 40px">
      <mj-include path="./partial/welcome.mjml" />
      <mj-section mj-class="bg--blue-100" border-radius="6px 6px 0 0" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if is_support_email %}
          <!-- Support section -->
            {% blocktranslate with title=product_title %}
              A withdrawal request has been submitted for:
              <div>
                <ul>
                  <li><strong>Certificate</strong>: {{ title }}</li>
                  <li><strong>Order ID</strong>: '{{ order_id }}'</li>
                  <li><strong>Learner</strong>: {{ buyer_fullname }} </li>
                </ul>
              </div>
            {% endblocktranslate %}
          {% else %}
          <!-- Buyer section -->
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT"%}
              We acknowledge receipt of your withdrawal request for:
              <div>
                <ul>
                  <li><strong>Certificate</strong>: {{ title }}</li>
                  <li><strong>Ref.</strong>: {{ course_code }} </li>
                  <li><strong>Order ID</strong>: '{{ order_id }}'</li>
                </ul>
              </div>
              <br>
              Your request, registered on <strong>{{ withdrawal_request_date }}</strong>, is being processed.
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if is_support_email %}
          <!-- Support section -->
            {% blocktranslate %}
              Action required: Please review and validate the withdrawal in the backoffice. If the request is
              approved, ensure the refund is processed promptly.
            {% endblocktranslate %}
          {% else %}
          <!-- Buyer section -->
            {% blocktranslate %}
              Our team will review your request shortly. If approved, your refund will be processed promptly
              and credited to the original payment method used.
              <br><br>
              You will receive a confirmation once the review is complete.
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if is_support_email %}
            {% blocktranslate %}
            <!-- Support section closing -->
            <a href="{{ backoffice_dashboard_order_link }}">Link to backoffice</a>
            {% endblocktranslate %}
          {% else %}
            {% blocktranslate %}
            <!-- Buyer section -->
              Best regards,
              <br>
              {{ signature_by }}
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>
</mjml>
