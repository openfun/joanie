<mjml>
  <mj-include path="./partial/header.mjml" />
  <mj-body mj-class="bg--blue-100">
    <mj-wrapper css-class="wrapper" padding="20px 40px 40px 40px">
      <mj-include path="./partial/welcome.mjml" />
      <mj-section mj-class="bg--blue-100" border-radius="6px 6px 0 0" padding="0 50px 10px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if not is_organization_admin and not is_support_email and course_code %}
            <!--Learner section credential product-->
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              We acknowledge receipt of your withdrawal request submitted on <strong>{{ withdrawal_request_date }}</strong> for :
              <div>
                <ul>
                  <li><strong>Training course</strong>: {{ title }}</li>
                  <li><strong>Ref.</strong> {{ course_code }}</li>
                  <li><strong>Order ID</strong>: {{ order_id }}</li>
                </ul>
              </div>
            {% endblocktranslate %}
          {% elif not is_organization_admin and not is_support_email and not course_code %}
            <!--Learner section certificate product-->
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              We acknowledge receipt of your withdrawal request submitted on <strong>{{ withdrawal_request_date }}</strong> for :
              <div>
                <ul>
                  <li><strong>Certificate</strong>: {{ title }}</li>
                  <li><strong>Order ID</strong>: {{ order_id }}</li>
                </ul>
              </div>
            {% endblocktranslate %}
          {% elif is_support_email and not is_organization_admin and course_code %}
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              <!--Support credential section-->
              A withdrawal request has been confirmed for the following order:
              <div>
                <ul>
                  <li><strong>Order ID</strong>: {{ order_id }}</li>
                  <li><strong>Training course</strong>: {{ title }}</li>
                  <li><strong>Ref.</strong> {{ course_code }}</li>
                  <li><strong>Learner</strong>: {{ buyer_fullname }}
                  <li><strong>Request submitted on</strong>: {{ withdrawal_request_date }}
                </ul>
              </div>
            {% endblocktranslate %}
          {% elif is_support_email and not is_organization_admin and not course_code %}
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              <!--Support certificate section-->
              A withdrawal request has been confirmed for the following order:
              <div>
                <ul>
                  <li><strong>Order ID</strong>: {{ order_id }}</li>
                  <li><strong>Certificate</strong>: {{ title }}</li>
                  <li><strong>Learner</strong>: {{ buyer_fullname }}
                  <li><strong>Request submitted on</strong>: {{ withdrawal_request_date }}
                </ul>
              </div>
            {% endblocktranslate %}
          {% elif is_organization_admin and not is_support_email %}
            {% blocktranslate with title=product_title withdrawal_request_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              We inform you that the order <strong>'{{ order_id }}'</strong> for the training <strong>{{ title }}</strong> has been cancelled
              following a withdrawal request from the learner <strong>{{ buyer_fullname }}</strong> (submitted on <strong>{{withdrawal_request_date}}</strong>).
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
            {% if not course_code and not is_support_email and not is_organization_admin %}
              {% blocktranslate %}
                <!--Certificate product - Learner section-->
                This request has been processed, and your order has been cancelled accordingly. You may verify
                the status of your orders at any time via your <strong><a href="{{ dashboard_order_link }}">dashboard</a></strong>.
                <br><br>
                Your refund will be processed as soon as possible and credited to the original payment method used.
              {% endblocktranslate %}
            {% elif course_code and not is_support_email and not is_organization_admin %}
              {% blocktranslate %}
                <!--Credential product - Learner section-->
                This request has been processed, and your order has been cancelled accordingly.
                You may verify the status of your orders at any time via
                your <strong><a href="{{ dashboard_order_link }}">dashboard</a></strong>.
              {% endblocktranslate %}
            {% elif course_code and not is_support_email and is_organization_admin %}
              <!--Organization section-->
              {% blocktranslate %}
                <br>
                No further action is required on your part.
              {% endblocktranslate %}
            {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
            <!--Learner section-->
            {% if not is_support_email and not is_organization_admin %}
              {% blocktranslate %}
                Should you have any questions, please do not hesitate to contact our support team.
              {% endblocktranslate %}
            {% elif is_organization_admin and not is_support_email %}
              {% blocktranslate %}
                <!--Organization section-->
                Should you need additional information, please contact us.
              {% endblocktranslate %}
            {% elif is_support_email and not is_organization_admin %}
              {% blocktranslate %}
                <!--Support section-->
                The <strong><a href="{{ backoffice_dashboard_order_link }}">order</a></strong> has been automatically
                cancelled in the backoffice.
              {% endblocktranslate %}
            {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
            <!--Support section-->
            {% if is_support_email and not is_organization_admin and not course_code %}
              {% blocktranslate %}
                <strong>Action required</strong>: Please follow the refund procedure for this order.
              {% endblocktranslate %}
            <!-- Learner section -->
            {% elif not is_support_email or is_organization_admin %}
              {% blocktranslate %}
                Best regards,
                <br>
                {{ signature_by }}
              {% endblocktranslate %}
            {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>
</mjml>
