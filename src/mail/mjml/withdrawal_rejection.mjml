<mjml>
  <mj-include path="./partial/header.mjml" />
  <mj-body mj-class="bg--blue-100">
    <mj-wrapper css-class="wrapper" padding="20px 40px 40px 40px">
      <mj-include path="./partial/welcome.mjml" />
      <mj-section mj-class="bg--blue-100" border-radius="6px 6px 0 0" padding="0 50px 0 50px">
        <mj-column>
          <mj-text padding="0">
            {% if is_support_email %}
              {% blocktranslate with title=product_title withdrawal_requested_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
                <!--Support certificate case section-->
                The withdrawal request for:
                <div>
                  <ul>
                    <li><strong>Certificate</strong>: {{ title }}</li>
                    <li><strong>Order ID</strong>: '{{ order_id }}'</li>
                    <li><strong>Request submitted on</strong>: {{ withdrawal_requested_date }} has been rejected.</li>
                  </ul>
                </div>
              {% endblocktranslate %}
            {% else %}
            {% blocktranslate with title=product_title withdrawal_requested_date=withdrawal_requested_at|date:"DATETIME_FORMAT" %}
              After review by our support team, your withdrawal request submitted on {{ withdrawal_requested_date }} for:
              <div>
                <ul>
                  <li><strong>Certificate</strong>: {{ title }}</li>
                  <li><strong>Order ID</strong>: '{{ order_id }}'</li>
                </ul>
              </div>
              has been rejected.
              {% endblocktranslate %}
            {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if is_support_email %}
            {% blocktranslate %}
              <div>
                <ul>
                  <li>
                  <strong>Reason</strong>: The learner ({{ buyer_fullname }}) accessed the exam and thus waived their
                  14-day right of withdrawal, in accordance with the checkbox agreed during purchase:
                  "By accessing th exam, you acknowledge that you waive your 14-day right of withdrawal
                  as provided for in Article L221-18 of the French Consumer Code".
                  </li>
                  <li><strong>Order status</strong>: Active (no refund to process)</li>
                  <li><strong>Next steps</strong>: No action required unless the learner appeals the decision.</li>
                </ul>
              </div>
              <br><br>
              You may review the details in the <a href="{{ backoffice_dashboard_order_link }}">backoffice</a>
            {% endblocktranslate %}
          {% else %}
            {% blocktranslate %}
              <div>
                <ul>
                  <li>
                  <strong>Reason</strong>: You waived your 14-day right of
                    withdrawal by accessing the exam for this certificate. This waiver was
                    explicitly accepted by you during the purchase process, via the following
                    checkbox: "By accessing the exam, you acknowledge that you waive your 14-day
                    right of withdrawal as provided for in Article L221-18 of the French Consumer Code."
                  </li>
                  <li><strong>Consequence</strong>: Your order remains active and will continue as planned.</li>
                </ul>
              </div>
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
     <mj-section mj-class="bg--blue-100" padding="0 50px 20px 50px">
        <mj-column>
          <mj-text padding="0">
          {% if not is_support_email %}
            {% blocktranslate %}
            <!--Learner section closing-->
              If you believe this decision is incorrect or need further clarification,
              please contact our support team.
              <br><br>
              Best regards,
              <br>
              {{ signature_by }}
            {% endblocktranslate %}
          {% endif %}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>
</mjml>
