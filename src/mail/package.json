  "scripts": {
    "build-mjml-to-html": "./bin/mjml-to-html",
    "build-html-to-plain-text": "./bin/html-to-plain-text",
    "build": "yarn build-mjml-to-html; yarn build-html-to-plain-text;"
  },
  "volta": {
    "node": "20.18.2"
  },
